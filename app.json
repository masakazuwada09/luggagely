{
  "expo": {
    "name": "Luggagely",
    "slug": "luggagely",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/assets/aistudio/icon_27d1943b.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./public/assets/aistudio/icon_27d1943b.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D2643"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aistudio.baggageguard.xkzpmq",
      "buildNumber": "1",
      "icon": "./public/assets/aistudio/icon_27d1943b.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Luggagely requires camera access to run real-time Meta SAM segmentation and Muse Spark 1.3 weight detection on your luggage items.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.aistudio.baggageguard.xkzpmq",
      "adaptiveIcon": {
        "foregroundImage": "./public/assets/aistudio/icon_27d1943b.png",
        "backgroundColor": "#0D2643"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Baggage Guard to access your camera for real-time Meta SAM luggage segmentation and weight estimation."
        }
      ],
      "@react-native-google-signin/google-signin"
    ]
  }
}
